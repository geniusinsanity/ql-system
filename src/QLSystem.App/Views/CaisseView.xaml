<UserControl x:Class="QLSystem.App.Views.CaisseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Background="#f8fafc" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side: Search & Cart Table -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search & Barcode Bar -->
            <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,15" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" x:Name="SearchInput" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Height="45" FontSize="16"
                             Padding="12,0" VerticalContentAlignment="Center"
                             ToolTip="ابحث بالاسم، المرجع، المقاس، أو امسح الباركود مباشرة"/>

                    <TextBlock Grid.Column="0" Text="🔍 ابحث بالاسم، المرجع (VIS-440, PVC 32...) أو امسح الباركود [F1]..."
                               Foreground="#94a3b8" FontSize="15" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Column="1" Content="إضافة للسلة ↵" Command="{Binding AddToCartCommand}"
                            Style="{StaticResource BtnPrimary}" Height="45" Margin="10,0,0,0" Padding="15,0"/>
                </Grid>
            </Border>

            <!-- Search Dropdown Results (Visible when search has items) -->
            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,15" Padding="0"
                    Visibility="{Binding SearchResults.Count, Converter={x:Null}}">
                <!-- DataGrid for Cart -->
                <DataGrid ItemsSource="{Binding CartItems}" AutoGenerateColumns="False" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White"
                          RowHeight="40" FontSize="14" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المرجع (Réf)" Binding="{Binding Reference}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="تسمية السلعة (Désignation)" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat={}{0:N2} دج}" Width="110" IsReadOnly="True"/>
                        
                        <!-- Quantity Template Column with - and + buttons -->
                        <DataGridTemplateColumn Header="الكمية" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="-" Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Width="28" Height="28" FontWeight="Bold" Margin="2,0"/>
                                        <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="6,0"/>
                                        <Button Content="+" Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Width="28" Height="28" FontWeight="Bold" Margin="2,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="المجموع" Binding="{Binding TotalPrice, StringFormat={}{0:N2} دج}" Width="120" FontWeight="Bold" IsReadOnly="True"/>

                        <!-- Delete Button -->
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Foreground="#ef4444" Background="Transparent" BorderThickness="0"
                                            FontWeight="Bold" FontSize="16" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Bottom Status Notification -->
            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#10b981" FontWeight="SemiBold" FontSize="14"/>
        </Grid>

        <!-- Right Side: Totals & Checkout -->
        <Border Grid.Column="1" Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Invoice N° & Customer Select -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="{Binding InvoiceNumber, StringFormat='وصل رقم: {0}'}" FontSize="14" FontWeight="SemiBold" Foreground="#64748b" Margin="0,0,0,10"/>
                    <TextBlock Text="الزبون (Client):" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="FullName"
                              Height="38" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>

                <Separator Grid.Row="1" Margin="0,5,0,15" Background="#e2e8f0"/>

                <!-- Total Amount Banner -->
                <Border Grid.Row="2" Background="#1e40af" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="المجموع الصافي (NET À PAYER)" Foreground="#93c5fd" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N2} DZD}" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Financial Inputs: Discount, Paid, Change -->
                <StackPanel Grid.Row="3" Margin="0,0,0,20">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="تخفيض (Remise DA):" VerticalAlignment="Center" FontSize="14" Foreground="#475569"/>
                        <TextBox Grid.Column="1" Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="35" TextAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="المبلغ المدفوع (Espèces):" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#1e293b"/>
                        <TextBox Grid.Column="1" Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="35" TextAlignment="Right" FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="الصرف المرجع (Rendu):" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#047857"/>
                        <TextBlock Grid.Column="1" Text="{Binding ChangeAmount, StringFormat={}{0:N2} دج}" VerticalAlignment="Center" TextAlignment="Right" FontSize="16" FontWeight="Bold" Foreground="#047857"/>
                    </Grid>

                    <Grid Margin="0,0,0,5" Visibility="{Binding DebtAmount, Converter={x:Null}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="الباقي كريدي (Dette):" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#dc2626"/>
                        <TextBlock Grid.Column="1" Text="{Binding DebtAmount, StringFormat={}{0:N2} دج}" VerticalAlignment="Center" TextAlignment="Right" FontSize="16" FontWeight="Bold" Foreground="#dc2626"/>
                    </Grid>
                </StackPanel>

                <!-- Action Buttons: Cash / Credit / Clear -->
                <StackPanel Grid.Row="5">
                    <Button Content="[F2] دفع نقداً وطباعة التذكرة" Command="{Binding CheckoutCashCommand}"
                            Style="{StaticResource BtnSuccess}" Height="50" FontSize="16" Margin="0,0,0,10"/>

                    <Button Content="[F3] تسجيل بالكريدي (على الحساب)" Command="{Binding CheckoutCreditCommand}"
                            Style="{StaticResource BtnPrimary}" Height="45" FontSize="15" Margin="0,0,0,10"/>

                    <Button Content="[F5] إفراغ السلة (Vider)" Command="{Binding ClearCartCommand}"
                            Style="{StaticResource BtnDanger}" Height="38" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
