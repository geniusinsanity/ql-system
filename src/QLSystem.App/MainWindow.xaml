<Window x:Class="QLSystem.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:QLSystem.App.ViewModels"
        xmlns:views="clr-namespace:QLSystem.App.Views"
        mc:Ignorable="d"
        Title="QL System - برنامج تسيير محلات الكانكري والعتاد (Quincaillerie Algérie)" 
        Height="780" Width="1280" MinHeight="650" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0f172a"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- DataTemplates mapping ViewModels to Views -->
            <DataTemplate DataType="{x:Type vm:CaisseViewModel}">
                <views:CaisseView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StockViewModel}">
                <views:StockView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CreditViewModel}">
                <views:CreditView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TrialLockViewModel}">
                <views:TrialLockView/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar hidden when locked -->
            <ColumnDefinition Width="240">
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="240"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                <Setter Property="Width" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0f172a" BorderBrush="#1e293b" BorderThickness="0,0,1,0">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="5,10,0,30">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#1e40af" CornerRadius="6" Width="34" Height="34" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="QL" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="QL SYSTEM" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Quincaillerie Management" FontSize="11" Foreground="#64748b" Margin="44,2,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">
                    <Button Command="{Binding NavigateCaisseCommand}" Style="{StaticResource BtnNav}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛒" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="الكاسة والبيع (Caisse)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateStockCommand}" Style="{StaticResource BtnNav}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="المخزون والسلع (Stock)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateCreditCommand}" Style="{StaticResource BtnNav}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💳" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ديون الزبائن (Crédit)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateReportsCommand}" Style="{StaticResource BtnNav}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="التقارير والأرباح (Rapports)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateSettingsCommand}" Style="{StaticResource BtnNav}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="الإعدادات (Paramètres)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Margin="5,0,0,10">
                    <TextBlock Text="نسخة حاسوب واحد (Monoposte)" FontSize="11" Foreground="#475569"/>
                    <TextBlock Text="{Binding LicenseInfo.MachineId}" FontSize="10" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="v1.0.0 DZ • 2026" FontSize="11" Foreground="#64748b" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Background="#f8fafc">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header — compact license icon -->
            <Border Grid.Row="0" Background="White" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" Padding="25,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="نظام تسيير محلات الكانكري والعتاد" 
                               FontSize="15" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>

                    <!-- Small License Status Button -->
                    <Button Grid.Column="1" Command="{Binding OpenLicenseModalCommand}"
                            Padding="10,6" Cursor="Hand" VerticalAlignment="Center"
                            ToolTip="{Binding LicenseBadgeText}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#e2e8f0"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#f1f5f9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding LicenseIcon}" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LicenseShortText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding LicenseBadgeColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Active View -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
        </Grid>
    </Grid>
</Window>
